# Supabase (client — build-time)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase (server — for Storage uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Anthropic (server-side only)
ANTHROPIC_API_KEY=sk-ant-your-key

# OpenAI / DALL-E (server-side only)
OPENAI_API_KEY=sk-your-openai-key

# ElevenLabs (server-side only)
ELEVENLABS_API_KEY=your-elevenlabs-key

# CORS — production origin for Vercel functions
ALLOWED_ORIGIN=https://lumio.app

# Stripe
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret

# Resend (email)
RESEND_API_KEY=re_your-key
